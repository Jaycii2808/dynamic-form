const nguyenTacVietBloc = `
-- Style example: Rule State
    
    File State phải có đủ trạng thái Initial, Loading,  Success, Error từ  Abstract , có đủ props ở các state
    Là **base state**, các class state khác sẽ kế thừa. Dùng `Equatable` ( ví dụ   `StatisticsInitial` ,  `StatisticsLoading`,  `StatisticsSuccess, StatisticsError` 
    
    ```
    abstract class StatisticsState extends Equatable {
      final List<OrderModel>? allDataOrder;
     
    
      const StatisticsState({
        this.allDataOrder,
      });
    
      @override
      List<Object?> get props => [
        allDataOrder,
      ];
    }
    class StatisticsInitial extends StatisticsState {
      const StatisticsInitial({
        super.allDataOrder,
      });
       @override
      List<Object?> get props => [
        allDataOrder,
      ];
    }
    
    class StatisticsLoading extends StatisticsState {
      const StatisticsLoading({
        super.allDataOrder,
      });
    
      //fromState
      StatisticsLoading.fromState({required StatisticsState state})
          : super(
        allDataOrder: state.allDataOrder,
      );
       @override
      List<Object?> get props => [
        allDataOrder,
      ];
    }
    
    class StatisticsSuccess extends StatisticsState {
      const StatisticsSuccess({
        super.allDataOrder,
      });
       @override
      List<Object?> get props => [
        allDataOrder,
      ];
    }
    
    class StatisticsError extends StatisticsState {
     final String? errorMessage;
      const StatisticsError({
        super.allDataOrder,
        required this.errorMessage,
      });
       @override
      List<Object?> get props => [
        allDataOrder,errorMessage
      ];
    }
    
    ```
    
